# ==============================================================================
# VARTA AI Assistant — Environment Configuration Template
# Copy this file to '.env' and populate with your production or local secrets.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider options: 'openai' (default & production), 'mock' (for automated unit tests)
LLM_PROVIDER=openai

# OpenAI API Key (Required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model identifier (e.g. 'gpt-5', 'gpt-4o', 'gpt-4o-mini')
OPENAI_MODEL=gpt-5

# ------------------------------------------------------------------------------
# 2. Server & Environment Configuration
# ------------------------------------------------------------------------------
# Environment mode: 'development' or 'production'
VARTA_ENV=production

# Server Host and Port
VARTA_HOST=0.0.0.0
VARTA_PORT=8000

# Debug mode: 'true' or 'false' (Always 'false' in production)
VARTA_DEBUG=false

# Enable Interactive OpenAPI Docs (/docs, /redoc): 'true' or 'false'
VARTA_ENABLE_DOCS=true

# ------------------------------------------------------------------------------
# 3. Security & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, set specific origins (e.g. 'https://varta.yourdomain.com,http://localhost:3000').
# In development, '*' allows all origins.
VARTA_CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. Storage & Retrieval Paths (Optional Overrides)
# ------------------------------------------------------------------------------
# Directory paths default to relative paths within the workspace if omitted.
# VARTA_VECTOR_DB_DIR=data/vector_db
# VARTA_CONVERSATIONS_DIR=data/conversations
# VARTA_CONFIG_DIR=config
