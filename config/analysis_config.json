{
  "short_text_threshold": 20,
  "long_text_threshold": 1000,
  "categorical_ratio_threshold": 0.05,
  "identifier_uniqueness_threshold": 0.85,
  "text_avg_len_threshold": 40,
  "regex_patterns": {
    "html_tags": "<[^>]+>",
    "urls": "(?:https?://|www\\.)\\S+",
    "emojis": "[\\U0001F600-\\U0001F64F\\U0001F300-\\U0001F5FF\\U0001F680-\\U0001F6FF\\U0001F700-\\U0001F77F\\U0001F780-\\U0001F7FF\\U0001F800-\\U0001F8FF\\U0001F900-\\U0001F9FF\\U0001FA00-\\U0001FA6F\\U0001FA70-\\U0001FAFF\\u2600-\\u26FF\\u2700-\\u27BF]",
    "line_breaks": "[\\r\\n]",
    "extra_whitespace": "[ \\t]{2,}",
    "non_printable": "[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]"
  }
}
